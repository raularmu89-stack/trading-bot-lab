//@version=6
indicator("Zonas de Rebote", shorttitle="Rebote", overlay=true, max_boxes_count=60, max_labels_count=50, max_lines_count=20)

// ── INPUTS ────────────────────────────────────────────────────────────────────
pivot_len   = input.int(10,   "Longitud Pivot",        group="Config", minval=3, maxval=50)
cluster_pct = input.float(0.20, "Amplitud de zona (%)", group="Config", minval=0.1, maxval=5.0, step=0.1)
min_touches = input.int(2,    "Toques minimos",         group="Config", minval=1, maxval=8)
max_zones   = input.int(6,    "Zonas a mostrar",        group="Config", minval=1, maxval=10)
zone_extend = input.int(40,   "Extension derecha",      group="Config", minval=0, maxval=200)
n_pivots    = input.int(6,    "Pivots tendencia",       group="Config", minval=3, maxval=12)
trend_tol   = input.float(0.30, "Tolerancia tendencia (%)", group="Config", minval=0.05, maxval=2.0, step=0.05)
sl_mult     = input.float(1.5, "Buffer SL (x zona)",    group="Config", minval=0.5, maxval=5.0, step=0.1)

// ── COLORES: rojo=resistencia  verde=soporte  intensidad=fuerza ───────────────
f_bg(score, is_resist)  => is_resist ? color.new(#B71C1C, math.max(5,  65 - score * 9)) : color.new(#1B5E20, math.max(5,  65 - score * 9))
f_brd(score, is_resist) => is_resist ? color.new(#FF1744, math.max(0,  40 - score * 7)) : color.new(#00E676, math.max(0,  40 - score * 7))

// ── PIVOTS ────────────────────────────────────────────────────────────────────
ph = ta.pivothigh(high, pivot_len, pivot_len)
pl = ta.pivotlow(low,  pivot_len, pivot_len)

var array<float> ph_prices = array.new<float>()
var array<int>   ph_bars   = array.new<int>()
var array<float> pl_prices = array.new<float>()
var array<int>   pl_bars   = array.new<int>()

if not na(ph)
    array.push(ph_prices, ph)
    array.push(ph_bars, bar_index - pivot_len)
    if array.size(ph_prices) > n_pivots
        array.shift(ph_prices)
        array.shift(ph_bars)

if not na(pl)
    array.push(pl_prices, pl)
    array.push(pl_bars, bar_index - pivot_len)
    if array.size(pl_prices) > n_pivots
        array.shift(pl_prices)
        array.shift(pl_bars)

// ── CLUSTERING S/R ────────────────────────────────────────────────────────────
var array<float> sr_price   = array.new<float>()
var array<int>   sr_touches = array.new<int>()
var array<bool>  sr_resist  = array.new<bool>()

if not na(ph)
    tol    = ph * cluster_pct / 100.0
    merged = false
    n_sr   = array.size(sr_price)
    if n_sr > 0
        for i = 0 to n_sr - 1
            if array.get(sr_resist, i) and math.abs(array.get(sr_price, i) - ph) <= tol
                old_p = array.get(sr_price, i)
                old_t = array.get(sr_touches, i)
                array.set(sr_price, i, (old_p * old_t + ph) / (old_t + 1))
                array.set(sr_touches, i, old_t + 1)
                merged := true
                break
    if not merged
        array.push(sr_price, ph)
        array.push(sr_touches, 1)
        array.push(sr_resist, true)

if not na(pl)
    tol    = pl * cluster_pct / 100.0
    merged = false
    n_sr   = array.size(sr_price)
    if n_sr > 0
        for i = 0 to n_sr - 1
            if not array.get(sr_resist, i) and math.abs(array.get(sr_price, i) - pl) <= tol
                old_p = array.get(sr_price, i)
                old_t = array.get(sr_touches, i)
                array.set(sr_price, i, (old_p * old_t + pl) / (old_t + 1))
                array.set(sr_touches, i, old_t + 1)
                merged := true
                break
    if not merged
        array.push(sr_price, pl)
        array.push(sr_touches, 1)
        array.push(sr_resist, false)

// ── RENDER ────────────────────────────────────────────────────────────────────
var array<box>   all_boxes  = array.new<box>()
var array<label> all_labels = array.new<label>()
var array<line>  all_lines  = array.new<line>()

if barstate.islast
    for bx in all_boxes
        box.delete(bx)
    for lb in all_labels
        label.delete(lb)
    for ln in all_lines
        line.delete(ln)
    array.clear(all_boxes)
    array.clear(all_labels)
    array.clear(all_lines)

    // ── 1. Trendline resistencia ──────────────────────────────────────────────
    td_r_price   = float(na)
    td_r_touches = 0
    sz_h = array.size(ph_prices)
    if sz_h >= 2
        bt_h  = 0
        bsl_h = 0.0
        bic_h = 0.0
        for i = 0 to sz_h - 2
            p1 = array.get(ph_prices, i)
            b1 = float(array.get(ph_bars, i))
            for j = i + 1 to sz_h - 1
                p2 = array.get(ph_prices, j)
                b2 = float(array.get(ph_bars, j))
                if b1 == b2
                    continue
                sl = (p2 - p1) / (b2 - b1)
                ic = p1 - sl * b1
                t  = 0
                for k = 0 to sz_h - 1
                    pk  = array.get(ph_prices, k)
                    bk  = float(array.get(ph_bars, k))
                    prj = sl * bk + ic
                    if math.abs(pk - prj) <= prj * trend_tol / 100.0
                        t += 1
                if t > bt_h
                    bt_h  := t
                    bsl_h := sl
                    bic_h := ic
        if bt_h >= 2
            td_r_price   := bsl_h * float(bar_index) + bic_h
            td_r_touches := bt_h

    // ── 2. Trendline soporte ──────────────────────────────────────────────────
    td_s_price   = float(na)
    td_s_touches = 0
    sz_l = array.size(pl_prices)
    if sz_l >= 2
        bt_l  = 0
        bsl_l = 0.0
        bic_l = 0.0
        for i = 0 to sz_l - 2
            p1 = array.get(pl_prices, i)
            b1 = float(array.get(pl_bars, i))
            for j = i + 1 to sz_l - 1
                p2 = array.get(pl_prices, j)
                b2 = float(array.get(pl_bars, j))
                if b1 == b2
                    continue
                sl = (p2 - p1) / (b2 - b1)
                ic = p1 - sl * b1
                t  = 0
                for k = 0 to sz_l - 1
                    pk  = array.get(pl_prices, k)
                    bk  = float(array.get(pl_bars, k))
                    prj = sl * bk + ic
                    if math.abs(pk - prj) <= prj * trend_tol / 100.0
                        t += 1
                if t > bt_l
                    bt_l  := t
                    bsl_l := sl
                    bic_l := ic
        if bt_l >= 2
            td_s_price   := bsl_l * float(bar_index) + bic_l
            td_s_touches := bt_l

    // ── 3. Puntuar S/R ────────────────────────────────────────────────────────
    n = array.size(sr_price)
    if n > 0
        scores = array.new<int>(n)
        for i = 0 to n - 1
            price   = array.get(sr_price, i)
            touches = array.get(sr_touches, i)
            score   = touches
            tol_z   = price * cluster_pct * 1.5 / 100.0
            if not na(td_r_price) and math.abs(price - td_r_price) <= tol_z
                score += td_r_touches
            if not na(td_s_price) and math.abs(price - td_s_price) <= tol_z
                score += td_s_touches
            array.set(scores, i, score)

        // ── 4. Ordenar por puntuacion ─────────────────────────────────────────
        sorted = array.new<int>(n)
        for i = 0 to n - 1
            array.set(sorted, i, i)
        if n > 1
            for i = 1 to n - 1
                ki = array.get(sorted, i)
                kt = array.get(scores, ki)
                j  = i - 1
                while j >= 0
                    if array.get(scores, array.get(sorted, j)) >= kt
                        break
                    array.set(sorted, j + 1, array.get(sorted, j))
                    j -= 1
                array.set(sorted, j + 1, ki)

        // ── 5. Zonas S/R — borde mas grueso cuanto mayor puntuacion ──────────
        drawn = 0
        for k = 0 to n - 1
            if drawn >= max_zones
                break
            idx     = array.get(sorted, k)
            touches = array.get(sr_touches, idx)
            price   = array.get(sr_price, idx)
            resist  = array.get(sr_resist, idx)
            score   = array.get(scores, idx)
            if touches < min_touches
                break

            zone_h  = price * cluster_pct * 0.7 / 100.0
            top_p   = price + zone_h
            bot_p   = price - zone_h
            brd_w   = score >= 7 ? 3 : score >= 4 ? 2 : 1

            prob    = score >= 7 ? "ALTA" : score >= 4 ? "MEDIA" : "BAJA"
            conf    = (not na(td_r_price) and math.abs(price - td_r_price) <= zone_h) or (not na(td_s_price) and math.abs(price - td_s_price) <= zone_h) ? " + TENDENCIA" : ""
            lbl_txt = (resist ? "RESISTENCIA" : "SOPORTE") + " | " + prob + conf + "  (x" + str.tostring(touches) + ")"

            array.push(all_boxes,
                box.new(bar_index - 120, top_p, bar_index + zone_extend, bot_p,
                        border_color = f_brd(score, resist),
                        border_width = brd_w,
                        bgcolor      = f_bg(score, resist),
                        text         = lbl_txt,
                        text_color   = color.white,
                        text_size    = size.small,
                        text_halign  = text.align_right,
                        text_valign  = text.align_center))
            drawn += 1

        // ── 6. Setup LARGO ────────────────────────────────────────────────────
        cur_close = close
        l_right   = bar_index + zone_extend
        l_left    = bar_index - 30

        long_idx  = -1
        long_dist = float(na)
        for k = 0 to n - 1
            idx     = array.get(sorted, k)
            price   = array.get(sr_price, idx)
            resist  = array.get(sr_resist, idx)
            touches = array.get(sr_touches, idx)
            if not resist and price < cur_close and touches >= min_touches
                dist = cur_close - price
                if na(long_dist) or dist < long_dist
                    long_dist := dist
                    long_idx  := idx

        if long_idx >= 0
            lp      = array.get(sr_price, long_idx)
            lzone_h = lp * cluster_pct * 0.7 / 100.0
            l_entry = lp + lzone_h
            l_sl    = lp - lzone_h * sl_mult
            l_risk  = l_entry - l_sl

            // TPs: resistencias por encima de la entrada
            l_tp_prices = array.new<float>()
            for k = 0 to n - 1
                idx     = array.get(sorted, k)
                price   = array.get(sr_price, idx)
                resist  = array.get(sr_resist, idx)
                touches = array.get(sr_touches, idx)
                if resist and price > l_entry and touches >= min_touches
                    array.push(l_tp_prices, price)
            array.sort(l_tp_prices, order.ascending)
            n_l_tps  = array.size(l_tp_prices)
            l_tp_cnt = math.min(n_l_tps, 3)

            // Mejor R:R para la flecha de entrada
            l_max_rr = n_l_tps > 0 and l_risk > 0 ? (array.get(l_tp_prices, l_tp_cnt - 1) - l_entry) / l_risk : 0.0
            l_rr_lbl = l_max_rr > 0 ? "\nmax " + str.tostring(math.round(l_max_rr * 10) / 10.0) + "R" : ""

            // Bloque de riesgo (SL -> entrada), rojo translucido
            array.push(all_boxes, box.new(bar_index + 1, l_entry, l_right, l_sl,
                bgcolor=color.new(#FF1744, 88), border_color=color.new(#FF1744, 60), border_width=1))

            // Bloques de recompensa apilados (entrada -> TP1 -> TP2 -> TP3)
            prev_l = l_entry
            if n_l_tps > 0
                for t = 0 to l_tp_cnt - 1
                    tp_p    = array.get(l_tp_prices, t)
                    b_alpha = t == 0 ? 82 : t == 1 ? 87 : 91
                    array.push(all_boxes, box.new(bar_index + 1, tp_p, l_right, prev_l,
                        bgcolor=color.new(#00C853, b_alpha), border_color=color.new(#00C853, 60), border_width=1))
                    prev_l := tp_p

            // Linea de entrada + flecha hacia arriba
            array.push(all_lines, line.new(l_left, l_entry, l_right, l_entry,
                color=color.new(#FFEB3B, 0), width=3, style=line.style_dashed))
            array.push(all_labels, label.new(bar_index, l_entry,
                "▲ LARGO" + l_rr_lbl,
                color=color.new(#FFEB3B, 5), textcolor=color.black,
                size=size.normal, style=label.style_arrowup))

            // Linea SL
            array.push(all_lines, line.new(l_left, l_sl, l_right, l_sl,
                color=color.new(#FF1744, 0), width=2, style=line.style_solid))
            array.push(all_labels, label.new(l_right, l_sl, "SL",
                color=color.new(#FF1744, 10), textcolor=color.white,
                size=size.small, style=label.style_label_left))

            // Lineas TP
            if n_l_tps > 0
                for t = 0 to l_tp_cnt - 1
                    tp_price = array.get(l_tp_prices, t)
                    rr       = l_risk > 0 ? (tp_price - l_entry) / l_risk : 0.0
                    rr_txt   = str.tostring(math.round(rr * 10) / 10.0)
                    tp_alpha = t == 0 ? 0 : t == 1 ? 25 : 50
                    tp_w     = t == 0 ? 2 : 1
                    tp_col   = color.new(#00C853, tp_alpha)
                    array.push(all_lines, line.new(l_left, tp_price, l_right, tp_price,
                        color=tp_col, width=tp_w, style=line.style_dashed))
                    array.push(all_labels, label.new(l_right, tp_price,
                        "TP" + str.tostring(t + 1) + "  " + rr_txt + "R",
                        color=tp_col, textcolor=color.white,
                        size=size.small, style=label.style_label_left))

        // ── 7. Setup CORTO ────────────────────────────────────────────────────
        s_right   = bar_index + zone_extend
        s_left    = bar_index - 30

        short_idx  = -1
        short_dist = float(na)
        for k = 0 to n - 1
            idx     = array.get(sorted, k)
            price   = array.get(sr_price, idx)
            resist  = array.get(sr_resist, idx)
            touches = array.get(sr_touches, idx)
            if resist and price > cur_close and touches >= min_touches
                dist = price - cur_close
                if na(short_dist) or dist < short_dist
                    short_dist := dist
                    short_idx  := idx

        if short_idx >= 0
            sp      = array.get(sr_price, short_idx)
            szone_h = sp * cluster_pct * 0.7 / 100.0
            s_entry = sp - szone_h
            s_sl    = sp + szone_h * sl_mult
            s_risk  = s_sl - s_entry

            // TPs: soportes por debajo de la entrada
            s_tp_prices = array.new<float>()
            for k = 0 to n - 1
                idx     = array.get(sorted, k)
                price   = array.get(sr_price, idx)
                resist  = array.get(sr_resist, idx)
                touches = array.get(sr_touches, idx)
                if not resist and price < s_entry and touches >= min_touches
                    array.push(s_tp_prices, price)
            array.sort(s_tp_prices, order.descending)
            n_s_tps  = array.size(s_tp_prices)
            s_tp_cnt = math.min(n_s_tps, 3)

            // Mejor R:R para la flecha
            s_max_rr = n_s_tps > 0 and s_risk > 0 ? (s_entry - array.get(s_tp_prices, s_tp_cnt - 1)) / s_risk : 0.0
            s_rr_lbl = s_max_rr > 0 ? "\nmax " + str.tostring(math.round(s_max_rr * 10) / 10.0) + "R" : ""

            // Bloque de riesgo (entrada -> SL), rojo translucido
            array.push(all_boxes, box.new(bar_index + 1, s_sl, s_right, s_entry,
                bgcolor=color.new(#FF1744, 88), border_color=color.new(#FF1744, 60), border_width=1))

            // Bloques de recompensa apilados (entrada -> TP1 -> TP2 -> TP3)
            prev_s = s_entry
            if n_s_tps > 0
                for t = 0 to s_tp_cnt - 1
                    tp_p    = array.get(s_tp_prices, t)
                    b_alpha = t == 0 ? 82 : t == 1 ? 87 : 91
                    array.push(all_boxes, box.new(bar_index + 1, prev_s, s_right, tp_p,
                        bgcolor=color.new(#00E5FF, b_alpha), border_color=color.new(#00E5FF, 60), border_width=1))
                    prev_s := tp_p

            // Linea de entrada + flecha hacia abajo
            array.push(all_lines, line.new(s_left, s_entry, s_right, s_entry,
                color=color.new(#FFD600, 0), width=3, style=line.style_dashed))
            array.push(all_labels, label.new(bar_index, s_entry,
                "▼ CORTO" + s_rr_lbl,
                color=color.new(#FFD600, 5), textcolor=color.black,
                size=size.normal, style=label.style_arrowdown))

            // Linea SL
            array.push(all_lines, line.new(s_left, s_sl, s_right, s_sl,
                color=color.new(#FF1744, 0), width=2, style=line.style_solid))
            array.push(all_labels, label.new(s_right, s_sl, "SL",
                color=color.new(#FF1744, 10), textcolor=color.white,
                size=size.small, style=label.style_label_left))

            // Lineas TP
            if n_s_tps > 0
                for t = 0 to s_tp_cnt - 1
                    tp_price = array.get(s_tp_prices, t)
                    rr       = s_risk > 0 ? (s_entry - tp_price) / s_risk : 0.0
                    rr_txt   = str.tostring(math.round(rr * 10) / 10.0)
                    tp_alpha = t == 0 ? 0 : t == 1 ? 25 : 50
                    tp_w     = t == 0 ? 2 : 1
                    tp_col   = color.new(#00E5FF, tp_alpha)
                    array.push(all_lines, line.new(s_left, tp_price, s_right, tp_price,
                        color=tp_col, width=tp_w, style=line.style_dashed))
                    array.push(all_labels, label.new(s_right, tp_price,
                        "TP" + str.tostring(t + 1) + "  " + rr_txt + "R",
                        color=tp_col, textcolor=color.white,
                        size=size.small, style=label.style_label_left))
