// ============================================================================
// SMC Pro — Raul Trading Lab
// Pine Script v6
//
// Porta la SMCStrategy del backtester Python al chart de TradingView.
//
// Componentes:
//   · Market Structure : BOS y CHoCH con swing detection (ta.pivothigh/low)
//   · Fair Value Gaps  : cajas coloreadas — lógica directa de fvg.py
//   · Order Blocks     : última vela contraria antes de cada BOS
//   · EMA Filter       : precio vs EMA lenta como filtro de tendencia
//   · Premium/Discount : midline del rango de los últimos N swings
//   · SL/TP            : niveles ATR automáticos en cada señal
//   · Régimen ADX      : fondo coloreado según tendencia/lateral
//   · Alertas          : BUY / SELL / CHoCH configurables
//
// Configuración recomendada (ganadora del backtester):
//   Swing Length = 10 | SL mult = 2.0 | TP mult = 4.0 | EMA filter ON
// ============================================================================

//@version=6
indicator(
    title            = "SMC Pro — Raul Trading Lab",
    overlay          = true,
    max_boxes_count  = 500,
    max_lines_count  = 500,
    max_labels_count = 500
)

// ─── USER-DEFINED TYPES (v6) ──────────────────────────────────────────────────

type FVGZone
    float top = na
    float bot = na

type OBZone
    float top   = na
    float bot   = na
    int   bar_x = na

// ─── GRUPOS ───────────────────────────────────────────────────────────────────

const string G_STR = "📐 Market Structure"
const string G_FVG = "🔷 Fair Value Gaps"
const string G_OB  = "🟩 Order Blocks"
const string G_EMA = "📈 EMA Filter"
const string G_SIG = "🎯 Señales y SL/TP"
const string G_REG = "🌡️ Régimen (ADX)"
const string G_PD  = "⚖️ Premium / Discount"

// ─── INPUTS ───────────────────────────────────────────────────────────────────

// Market Structure
int   swing_len    = input.int(10,    "Swing Length (velas a cada lado)", minval=3, maxval=50, group=G_STR)
bool  show_bos     = input.bool(true, "Mostrar BOS",   group=G_STR)
bool  show_choch   = input.bool(true, "Mostrar CHoCH", group=G_STR)
color col_bull_str = input.color(color.teal, "Color alcista", group=G_STR, inline="sc")
color col_bear_str = input.color(color.red,  "Color bajista", group=G_STR, inline="sc")

// FVG
bool  show_fvg    = input.bool(true,  "Mostrar FVGs",                 group=G_FVG)
bool  require_fvg = input.bool(false, "Exigir FVG para señal",        group=G_FVG)
float fvg_min_pct = input.float(0.0, "Tamaño mínimo FVG (% precio)", minval=0.0, step=0.01, group=G_FVG)
int   fvg_extend  = input.int(15,    "Extender caja N velas",         minval=1, maxval=50,  group=G_FVG)

// Order Blocks
bool show_ob    = input.bool(true,  "Mostrar Order Blocks", group=G_OB)
bool require_ob = input.bool(false, "Exigir OB para señal", group=G_OB)
int  ob_extend  = input.int(20,    "Extender OB N velas",  minval=1, maxval=100, group=G_OB)

// EMA
bool use_ema      = input.bool(true, "Activar filtro EMA",   group=G_EMA)
int  ema_fast_len = input.int(21,   "EMA Rápida",            minval=2,  group=G_EMA)
int  ema_slow_len = input.int(200,  "EMA Lenta (tendencia)", minval=10, group=G_EMA)

// SL/TP
int   atr_len   = input.int(14,    "ATR Period",            minval=1,   group=G_SIG)
float sl_mult   = input.float(2.0, "SL Multiplicador ATR",  minval=0.5, step=0.5, group=G_SIG)
float tp_mult   = input.float(4.0, "TP Multiplicador ATR",  minval=0.5, step=0.5, group=G_SIG)
bool  show_sltp = input.bool(true, "Mostrar SL/TP en señal", group=G_SIG)

// Régimen ADX
bool use_regime     = input.bool(false, "Filtrar laterales (ADX)",  group=G_REG)
int  adx_len        = input.int(14,    "ADX Period",                 minval=1, group=G_REG)
int  adx_thresh     = input.int(20,    "ADX umbral de tendencia",    minval=5, group=G_REG)
bool show_regime_bg = input.bool(true, "Fondo régimen en chart",     group=G_REG)

// Premium / Discount
bool show_pd = input.bool(true,  "Mostrar midline P/D",        group=G_PD)
int  pd_len  = input.int(100,   "Lookback rango P/D",         minval=20, group=G_PD)
bool use_pd  = input.bool(false, "Exigir zona P/D para señal", group=G_PD)

// ─── INDICADORES BASE ─────────────────────────────────────────────────────────

float atr      = ta.atr(atr_len)
float ema_fast = ta.ema(close, ema_fast_len)
float ema_slow = ta.ema(close, ema_slow_len)

[di_plus, di_minus, adx_val] = ta.dmi(adx_len, adx_len)
bool is_trending = not use_regime or adx_val >= adx_thresh

// ─── SWING DETECTION ──────────────────────────────────────────────────────────
// Pivots confirmados con retraso de swing_len velas

float ph = ta.pivothigh(high, swing_len, swing_len)
float pl = ta.pivotlow (low,  swing_len, swing_len)

var float last_sh     = na
var int   last_sh_bar = na
var float last_sl     = na
var int   last_sl_bar = na

if not na(ph)
    last_sh     := ph
    last_sh_bar := bar_index - swing_len

if not na(pl)
    last_sl     := pl
    last_sl_bar := bar_index - swing_len

// ─── ESTRUCTURA DE MERCADO ────────────────────────────────────────────────────
// trend: 0=indefinido  1=bullish  -1=bearish

var int trend = 0

// Crossover limpio: cierre de hoy rompe, cierre de ayer no rompía
bool bull_break = not na(last_sh) and close > last_sh and close[1] <= last_sh[1]
bool bear_break = not na(last_sl) and close < last_sl and close[1] >= last_sl[1]

// Clasificar según tendencia previa al evento
bool bull_bos   = bull_break and trend == 1     // continuación alcista
bool bull_choch = bull_break and trend == -1    // cambio de carácter → alcista
bool bear_bos   = bear_break and trend == -1    // continuación bajista
bool bear_choch = bear_break and trend == 1     // cambio de carácter → bajista

if bull_break
    trend := 1
if bear_break
    trend := -1

// ─── FAIR VALUE GAPS ──────────────────────────────────────────────────────────
// Equivalente exacto de fvg.py (conversión del Pine original 'raul smc'):
//   Bullish FVG : low[0] > high[2]  AND  close[1] > high[2]
//   Bearish FVG : high[0] < low[2]  AND  close[1] < low[2]

bool fvg_sz_bull = fvg_min_pct == 0.0 or (low - high[2]) / close * 100 >= fvg_min_pct
bool fvg_sz_bear = fvg_min_pct == 0.0 or (low[2] - high) / close * 100 >= fvg_min_pct

bool bull_fvg_raw = low > high[2] and close[1] > high[2] and fvg_sz_bull
bool bear_fvg_raw = high < low[2] and close[1] < low[2]  and fvg_sz_bear

var FVGZone bull_fvg_z = FVGZone.new()
var FVGZone bear_fvg_z = FVGZone.new()

if bull_fvg_raw
    bull_fvg_z.top := low      // top del gap = low de la vela actual
    bull_fvg_z.bot := high[2]  // bot del gap = high de hace 2 velas

if bear_fvg_raw
    bear_fvg_z.top := low[2]
    bear_fvg_z.bot := high

bool in_bull_fvg = not na(bull_fvg_z.top) and close >= bull_fvg_z.bot and close <= bull_fvg_z.top
bool in_bear_fvg = not na(bear_fvg_z.top) and close >= bear_fvg_z.bot and close <= bear_fvg_z.top

if show_fvg and bull_fvg_raw
    box.new(bar_index - 2, high[2], bar_index + fvg_extend, low,
            border_color = color.new(col_bull_str, 60),
            bgcolor      = color.new(col_bull_str, 88),
            border_width = 1)

if show_fvg and bear_fvg_raw
    box.new(bar_index - 2, high, bar_index + fvg_extend, low[2],
            border_color = color.new(col_bear_str, 60),
            bgcolor      = color.new(col_bear_str, 88),
            border_width = 1)

// ─── ORDER BLOCKS ─────────────────────────────────────────────────────────────
// Bullish OB : última vela bajista (close < open) antes de un BOS/CHoCH alcista
// Bearish OB : última vela alcista (close > open) antes de un BOS/CHoCH bajista

var OBZone bull_ob_z = OBZone.new()
var OBZone bear_ob_z = OBZone.new()

if bull_break
    bull_ob_z.top   := high[1]
    bull_ob_z.bot   := low[1]
    bull_ob_z.bar_x := bar_index - 1

if bear_break
    bear_ob_z.top   := high[1]
    bear_ob_z.bot   := low[1]
    bear_ob_z.bar_x := bar_index - 1

bool in_bull_ob = not na(bull_ob_z.top) and close >= bull_ob_z.bot and close <= bull_ob_z.top
bool in_bear_ob = not na(bear_ob_z.top) and close >= bear_ob_z.bot and close <= bear_ob_z.top

if show_ob and bull_break and not na(bull_ob_z.bar_x)
    box.new(bull_ob_z.bar_x, bull_ob_z.bot, bar_index + ob_extend, bull_ob_z.top,
            border_color = color.new(col_bull_str, 40),
            bgcolor      = color.new(col_bull_str, 82),
            border_width = 2)

if show_ob and bear_break and not na(bear_ob_z.bar_x)
    box.new(bear_ob_z.bar_x, bear_ob_z.bot, bar_index + ob_extend, bear_ob_z.top,
            border_color = color.new(col_bear_str, 40),
            bgcolor      = color.new(col_bear_str, 82),
            border_width = 2)

// ─── PREMIUM / DISCOUNT ───────────────────────────────────────────────────────

float range_high = ta.highest(high, pd_len)
float range_low  = ta.lowest (low,  pd_len)
float range_mid  = (range_high + range_low) / 2.0

bool in_discount = close < range_mid
bool in_premium  = close > range_mid

// ─── FILTROS ──────────────────────────────────────────────────────────────────

bool ema_bull_ok = not use_ema or (close > ema_slow and ema_fast > ema_slow)
bool ema_bear_ok = not use_ema or (close < ema_slow and ema_fast < ema_slow)
bool fvg_bull_ok = not require_fvg or in_bull_fvg
bool fvg_bear_ok = not require_fvg or in_bear_fvg
bool ob_bull_ok  = not require_ob  or in_bull_ob
bool ob_bear_ok  = not require_ob  or in_bear_ob
bool pd_bull_ok  = not use_pd or in_discount
bool pd_bear_ok  = not use_pd or in_premium

// ─── SEÑALES ──────────────────────────────────────────────────────────────────

bool buy_signal  = (bull_bos or bull_choch) and ema_bull_ok and pd_bull_ok and fvg_bull_ok and ob_bull_ok and is_trending
bool sell_signal = (bear_bos or bear_choch) and ema_bear_ok and pd_bear_ok and fvg_bear_ok and ob_bear_ok and is_trending

// ─── PLOT ─────────────────────────────────────────────────────────────────────

plot(use_ema ? ema_fast : na, "EMA Rápida", color=color.new(color.yellow, 0),  linewidth=1)
plot(use_ema ? ema_slow : na, "EMA Lenta",  color=color.new(color.white,  30), linewidth=2)
plot(show_pd  ? range_mid : na, "P/D Midline",
     color=color.new(color.purple, 50), linewidth=1, style=plot.style_circles)

// BOS / CHoCH labels
if show_bos and bull_bos
    label.new(bar_index, low - atr * 0.8, "BOS",
              style=label.style_label_up,
              color=color.new(col_bull_str, 75), textcolor=col_bull_str, size=size.small)

if show_bos and bear_bos
    label.new(bar_index, high + atr * 0.8, "BOS",
              style=label.style_label_down,
              color=color.new(col_bear_str, 75), textcolor=col_bear_str, size=size.small)

if show_choch and bull_choch
    label.new(bar_index, low - atr * 0.8, "CHoCH",
              style=label.style_label_up,
              color=color.new(color.lime, 65), textcolor=color.lime, size=size.small)

if show_choch and bear_choch
    label.new(bar_index, high + atr * 0.8, "CHoCH",
              style=label.style_label_down,
              color=color.new(color.orange, 65), textcolor=color.orange, size=size.small)

// Triángulos BUY / SELL
plotshape(buy_signal,  "BUY",  shape.triangleup,   location.belowbar, color=color.lime, size=size.normal)
plotshape(sell_signal, "SELL", shape.triangledown,  location.abovebar, color=color.red,  size=size.normal)

// SL / TP en cada señal
var line sl_line = na
var line tp_line = na

if buy_signal and show_sltp
    float sl_px = close - sl_mult * atr
    float tp_px = close + tp_mult * atr
    line.delete(sl_line)
    line.delete(tp_line)
    sl_line := line.new(bar_index, sl_px, bar_index + 25, sl_px, color=color.red,  width=2, style=line.style_dashed)
    tp_line := line.new(bar_index, tp_px, bar_index + 25, tp_px, color=color.lime, width=2, style=line.style_dashed)
    label.new(bar_index + 1, sl_px, "SL  " + str.format("{0,number,#.####}", sl_px),
              style=label.style_label_right, color=color.new(color.red, 80),  textcolor=color.red,  size=size.tiny)
    label.new(bar_index + 1, tp_px, "TP  " + str.format("{0,number,#.####}", tp_px),
              style=label.style_label_right, color=color.new(color.lime, 80), textcolor=color.lime, size=size.tiny)

if sell_signal and show_sltp
    float sl_px = close + sl_mult * atr
    float tp_px = close - tp_mult * atr
    line.delete(sl_line)
    line.delete(tp_line)
    sl_line := line.new(bar_index, sl_px, bar_index + 25, sl_px, color=color.red,  width=2, style=line.style_dashed)
    tp_line := line.new(bar_index, tp_px, bar_index + 25, tp_px, color=color.lime, width=2, style=line.style_dashed)
    label.new(bar_index + 1, sl_px, "SL  " + str.format("{0,number,#.####}", sl_px),
              style=label.style_label_right, color=color.new(color.red, 80),  textcolor=color.red,  size=size.tiny)
    label.new(bar_index + 1, tp_px, "TP  " + str.format("{0,number,#.####}", tp_px),
              style=label.style_label_right, color=color.new(color.lime, 80), textcolor=color.lime, size=size.tiny)

// ─── FONDO RÉGIMEN ────────────────────────────────────────────────────────────
// switch expression (v6): sustituye la cadena de ternarios anidados

color regime_col = switch
    is_trending and trend == 1  => color.new(color.teal, 94)
    is_trending and trend == -1 => color.new(color.red,  94)
    =>                             color.new(color.gray, 96)

bgcolor(show_regime_bg ? regime_col : na, title="Régimen fondo")

// ─── TABLA INFO ───────────────────────────────────────────────────────────────

var table info_tbl = table.new(position.top_right, 2, 6,
    bgcolor      = color.new(color.black, 70),
    border_color = color.new(color.gray, 60),
    border_width = 1)

// switch sobre variable entera (v6)
string trend_str = switch trend
    1  => "▲ ALCISTA"
    -1 => "▼ BAJISTA"
    =>    "◆ NEUTRO"

color trend_col = switch trend
    1  => color.teal
    -1 => color.red
    =>    color.gray

string regime_str = is_trending ? "TENDENCIA" : "LATERAL"
color  regime_c   = is_trending ? color.yellow : color.gray
string ema_str    = not use_ema ? "OFF" : ema_fast > ema_slow ? "▲ Bullish" : "▼ Bearish"
color  ema_col    = not use_ema ? color.gray  : ema_fast > ema_slow ? color.teal : color.red

if barstate.islast
    table.cell(info_tbl, 0, 0, "SMC PRO",         text_color=color.white,  text_size=size.small, bgcolor=color.new(color.navy, 50))
    table.cell(info_tbl, 1, 0, "Raul Trading Lab", text_color=color.silver, text_size=size.tiny,  bgcolor=color.new(color.navy, 50))
    table.cell(info_tbl, 0, 1, "Tendencia",        text_color=color.silver, text_size=size.tiny)
    table.cell(info_tbl, 1, 1, trend_str,          text_color=trend_col,    text_size=size.small)
    table.cell(info_tbl, 0, 2, "Régimen",          text_color=color.silver, text_size=size.tiny)
    table.cell(info_tbl, 1, 2, regime_str + "  ADX=" + str.format("{0,number,#.#}", adx_val),
               text_color=regime_c, text_size=size.tiny)
    table.cell(info_tbl, 0, 3, "ATR",              text_color=color.silver, text_size=size.tiny)
    table.cell(info_tbl, 1, 3, str.format("{0,number,#.####}", atr) + "  (" + str.format("{0,number,#.##}", atr / close * 100) + "%)",
               text_color=color.white, text_size=size.tiny)
    table.cell(info_tbl, 0, 4, "Zona P/D",         text_color=color.silver, text_size=size.tiny)
    table.cell(info_tbl, 1, 4, in_discount ? "DISCOUNT" : "PREMIUM",
               text_color=in_discount ? color.teal : color.orange, text_size=size.tiny)
    table.cell(info_tbl, 0, 5, "EMA Filter",       text_color=color.silver, text_size=size.tiny)
    table.cell(info_tbl, 1, 5, ema_str,            text_color=ema_col,      text_size=size.tiny)

// ─── ALERTAS ──────────────────────────────────────────────────────────────────
alertcondition(buy_signal,  "SMC BUY",               "SMC Pro ▲ BUY — {{ticker}} {{interval}} @ {{close}}")
alertcondition(sell_signal, "SMC SELL",              "SMC Pro ▼ SELL — {{ticker}} {{interval}} @ {{close}}")
alertcondition(bull_choch,  "CHoCH Alcista (setup)", "SMC: CHoCH alcista en {{ticker}}")
alertcondition(bear_choch,  "CHoCH Bajista (setup)", "SMC: CHoCH bajista en {{ticker}}")
